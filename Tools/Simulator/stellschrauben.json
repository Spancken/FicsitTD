  "Logik": [
    {
      "Text": "EP steigen mit der Welle",
      "Regel": "Einsatz.EP.JeWelle > 0"
    },
    {
      "Text": "voller Kern wird mehr belohnt als 75 %",
      "Regel": "Einsatz.EP.KernVoll >= Einsatz.EP.KernAb75"
    },
    {
      "Text": "Assembler kostet mindestens so viel wie Konstruktor",
      "Regel": "Einsatz.Laden.Assembler.Grundpreis >= Einsatz.Laden.Konstruktor.Grundpreis"
    },
    {
      "Text": "jedes weitere Gebaeude kostet mehr",
      "Regel": "Einsatz.Laden.Konstruktor.Aufschlag > 0 and Einsatz.Laden.Assembler.Aufschlag > 0"
    },
    {
      "Text": "Treibstoff staerker als Biotreibstoff",
      "Regel": "Munition.Treibstoff.Treibstoff.SchadenProSekunde > Munition.Treibstoff.Biotreibstoff.SchadenProSekunde"
    },
    {
      "Text": "Turbotreibstoff mindestens so stark wie Treibstoff",
      "Regel": "Munition.Treibstoff.Turbotreibstoff.SchadenProSekunde >= Munition.Treibstoff.Treibstoff.SchadenProSekunde"
    },
    {
      "Text": "Tesla behaelt Spruenge als Profil",
      "Regel": "Munition.Tesla.SprungFaktor >= 0.2"
    },
    {
      "Text": "Gegner werden mit der Welle zäher",
      "Regel": "Wellen.LPJeWelle > 0"
    },
    {
      "Text": "Wellen werden mit der Welle größer",
      "Regel": "Wellen.BudgetJeWelle > 0"
    },
    {
      "Text": "Armierungsbolzen bleibt stärker als Durchschlagbolzen je Treffer",
      "Regel": "Munition.Bolzen.Armierungsbolzen.Schaden >= Munition.Bolzen.Durchschlagbolzen.Schaden"
    },
    {
      "Text": "Teslaspule kostet mehr als ein Gewehrturm",
      "Regel": "Einsatz.Laden.Teslaspule.Grundpreis > Einsatz.Laden.Gewehrturm.Grundpreis"
    },
    {
      "Text": "Bolzenturm bleibt der billigste Turm",
      "Regel": "Einsatz.Laden.Bolzenturm.Grundpreis <= Einsatz.Laden.Gewehrturm.Grundpreis"
    }
  ]
