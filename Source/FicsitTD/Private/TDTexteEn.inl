		{ TEXT("Teslaspulen entladen mit Hochspannung aus dem Treibstoffkraftwerk: 30 % mehr Schaden. Stark gegen Wasserspucker."), TEXT("Tesla Coils discharge with high voltage from the Fuel-Powered Generator: 30% more damage. Strong against Water Spitters.") },
		{ TEXT("Teslaspulen entladen mit Hochspannung aus dem Treibstoffkraftwerk: 30 % mehr Schaden. Stark gegen Wasserspucker.\n\nAb Welle: 25\nBraucht: Elementar > Akkubank, Industrie > Treibstoffkraftwerk"), TEXT("Tesla Coils discharge with high voltage from the Fuel-Powered Generator: 30% more damage. Strong against Water Spitters.\n\nFrom wave: 25\nRequires: Elemental > Battery Bank, Industry > Fuel Power") },
		{ TEXT("Teslaspulen laden aus einem Puffer: beim Aufladen ziehen sie nur noch die Hälfte der Leistung aus dem Netz."), TEXT("Tesla Coils charge from a buffer: while charging they draw only half the power from the grid.") },
