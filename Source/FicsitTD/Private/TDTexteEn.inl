		{ TEXT("Kern +30 % Lebenspunkte"), TEXT("Core +30% health") },
		{ TEXT("Kern heilt 10 % je Welle"), TEXT("Core heals 10% per wave") },
		{ TEXT("Kern schießt selbst (30 m)"), TEXT("Core fires on its own (30 m)") },
		{ TEXT("Kern, Doktrin, Turmfertigung und Mauern: aushalten, reparieren, eine Hauptlinie wählen, Türme auf höhere Level bringen."), TEXT("Core, Doctrine, Turret Fabrication and walls: endure, repair, choose a main line, raise turrets to higher levels.") },
		{ TEXT("Kern-Geschütz"), TEXT("Core Cannon") },
