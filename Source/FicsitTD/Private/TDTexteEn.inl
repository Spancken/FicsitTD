		{ TEXT("Industrie > Förderband Mk2\nIndustrie > Gießerei und Stahl\nErforschbar ab Welle 10."), TEXT("Industry > Conveyor Belt Mk.2\nIndustry > Foundry and Steel\nResearchable from wave 10.") },
