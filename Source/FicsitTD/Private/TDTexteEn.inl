		{ TEXT("Schwefel-Vorkommen abbauen (Miner). Schwarzpulver wie im Originalspiel aus Kohle und Schwefel. Grundlage für Nobelisk, Brandmunition, Gas-Nobelisk und Kompaktkohle."), TEXT("Mine Sulfur deposits (Miner). Black Powder from Coal and Sulfur, as in the base game. Basis for Nobelisk, Incendiary Ammo, Gas Nobelisk and Compacted Coal.") },
		{ TEXT("Schwefel-Vorkommen abbauen (Miner). Schwarzpulver wie im Originalspiel aus Kohle und Schwefel. Grundlage für Nobelisk, Brandmunition, Gas-Nobelisk und Kompaktkohle.\n\nAb Welle: 5\nBraucht: Industrie > Gießerei und Stahl"), TEXT("Mine Sulfur deposits (Miner). Black Powder from Coal and Sulfur, as in the base game. Basis for Nobelisk, Incendiary Ammo, Gas Nobelisk and Compacted Coal.\n\nFrom wave: 5\nRequires: Industry > Foundry and Steel") },
		{ TEXT("Schwefel-Vorkommen abbauen (Miner). Schwefel steckt in Schwarzpulver (Nobelisk), Brandmunition, Gas-Nobelisk und Kompaktkohle; die Rezepte kommen mit den jeweiligen Knoten. Dieser Knoten ist der Zugang zu ihnen."), TEXT("Mine Sulfur deposits (Miner). Sulfur goes into Black Powder (Nobelisk), Incendiary Ammo, Gas Nobelisk and Compacted Coal; the recipes come with their respective nodes. This node is the gateway to them.") },
		{ TEXT("Schwefel-Vorkommen abbauen (Miner). Schwefel steckt in Schwarzpulver (Nobelisk), Brandmunition, Gas-Nobelisk und Kompaktkohle; die Rezepte kommen mit den jeweiligen Knoten. Dieser Knoten ist der Zugang zu ihnen.\n\nAb Welle: 5\nBraucht: Industrie > Gießerei und Stahl"), TEXT("Mine Sulfur deposits (Miner). Sulfur goes into Black Powder (Nobelisk), Incendiary Ammo, Gas Nobelisk and Compacted Coal; the recipes come with their respective nodes. This node is the gateway to them.\n\nFrom wave: 5\nRequires: Industry > Foundry and Steel") },
