		{ TEXT("Festung > Turmfertigung II\nElementar > Teslaspule\nErforschbar ab Welle 15."), TEXT("Fortress > Turret Fabrication II\nElemental > Tesla Coil\nResearchable from wave 15.") },
		{ TEXT("Festung > Turmfertigung II\nErforschbar ab Welle 15."), TEXT("Fortress > Turret Fabrication II\nResearchable from wave 15.") },
		{ TEXT("Festung > Turmfertigung II\nErforschbar ab Welle 20."), TEXT("Fortress > Turret Fabrication II\nResearchable from wave 20.") },
		{ TEXT("Festung > Turmfertigung III\nErforschbar ab Welle 30."), TEXT("Fortress > Turret Fabrication III\nResearchable from wave 30.") },
		{ TEXT("Festung > Turmfertigung IV: Meisterstufe\nErforschbar ab Welle 40."), TEXT("Fortress > Turret Fabrication IV: Master Tier\nResearchable from wave 40.") },
		{ TEXT("Festung > Turmfertigung IV: Meisterstufe\nErforschbar ab Welle 45."), TEXT("Fortress > Turret Fabrication IV: Master Tier\nResearchable from wave 45.") },
		{ TEXT("Festung > Turmfertigung IV: Meisterstufe\nIndustrie > Mischtechnik\nErforschbar ab Welle 35."), TEXT("Fortress > Turret Fabrication IV: Master Tier\nIndustry > Blending Technology\nResearchable from wave 35.") },
		{ TEXT("Festung > Verstärkte Mauern\nErforschbar ab Welle 12."), TEXT("Fortress > Reinforced Walls\nResearchable from wave 12.") },
		{ TEXT("Festung > Verstärkte Mauern\nErforschbar ab Welle 6."), TEXT("Fortress > Reinforced Walls\nResearchable from wave 6.") },
		{ TEXT("Festung > Verstärkte Mauern\nIndustrie > Quarzverarbeitung\nErforschbar ab Welle 12."), TEXT("Fortress > Reinforced Walls\nIndustry > Quartz Processing\nResearchable from wave 12.") },
		{ TEXT("Feuer entzündet das nasse Feld: Es brennt 5 s, wer hindurchläuft, brennt 3 s weiter. Erkennbar an Funken auf der Platte."), TEXT("Fire ignites the wet field: it burns for 5 s, and anyone walking through keeps burning for 3 s. Look for sparks on the plate.") },
		{ TEXT("Feuert Ficsonium-Ladungen (Band-Eingang, alle 8 s): Gegner in 12 m werden festgehalten und nach 1,5 s mit 1500 Explosionsschaden gesprengt. Braucht viel Strom."), TEXT("Fires Ficsonium charges (belt input, every 8 s): enemies within 12 m are held in place and blown up after 1.5 s with 1500 explosion damage. Needs a lot of power.") },
		{ TEXT("Ficsonium-Ladung abfeuern"), TEXT("Fire Ficsonium Charge") },
		{ TEXT("Flak-Kanister"), TEXT("Flak Canister") },
		{ TEXT("Flak-Kanister abfeuern"), TEXT("Fire Flak Canister") },
		{ TEXT("Flammenwerfer"), TEXT("Flamethrower") },
		{ TEXT("Flammenwerfer Stufe 2: Treibstoff + Kompaktkohle in der Raffinerie, 50 % mehr Schaden. Kompaktkohle: 5 Kohle + 5 Schwefel im Assembler.\n\nGut gegen: Schwärme\nAb Welle: 25\nBraucht: Elementar > Flammenwerfer, Industrie > Schwefel"), TEXT("Flamethrower tier 2: Fuel + Compacted Coal in the Refinery, 50% more damage. Compacted Coal: 5 Coal + 5 Sulfur in the Assembler.\n\nGood against: swarms\nFrom wave: 25\nRequires: Elemental > Flamethrower, Industry > Sulfur") },
		{ TEXT("Flammenwerfer Stufe 3: Raketentreibstoff aus Turbotreibstoff und Salpetersäure im Mischer (Salpetersäure aus Stickstoff, Wasser und Eisenplatten). 140 Schaden pro Sekunde, längeres Nachbrennen. FICSIT schenkt dazu ein Paket Förderanlagen für den Stickstoff.\n\nAb Welle: 35\nBraucht: Elementar > Turbotreibstoff, Industrie > Mischtechnik"), TEXT("Flamethrower tier 3: Rocket Fuel from Turbofuel and Nitric Acid in the Blender (Nitric Acid from Nitrogen, Water and Iron Plates). 140 damage per second, longer afterburn. FICSIT also gifts a package of extraction equipment for the Nitrogen.\n\nFrom wave: 35\nRequires: Elemental > Turbofuel, Industry > Blending Technology") },
		{ TEXT("Flammenwerfer Stufe 4: ionisierter Treibstoff aus Raketentreibstoff und Energie-Splittern in der Raffinerie. 160 Schaden pro Sekunde als Strom statt Feuer: wirkt gegen hitzefeste Wüsten- und Wasserspucker, betäubt kurz.\n\nAb Welle: 38\nBraucht: Elementar > Raketentreibstoff"), TEXT("Flamethrower tier 4: Ionized Fuel from Rocket Fuel and Power Shards in the Refinery. 160 damage per second as electricity instead of fire: works against heat-resistant Desert and Water Spitters, briefly stuns.\n\nFrom wave: 38\nRequires: Elemental > Rocket Fuel") },
		{ TEXT("Flammenwerfer: Aktion"), TEXT("Flamethrower: Action") },
		{ TEXT("Flugabwehr: schiesst Flak-Kanister (Band-Eingang) auf fliegende Krabben in 60 m, 200 Schaden in 6 m. Greift keine Bodengegner an. Braucht Strom."), TEXT("Anti-air: fires Flak Canisters (belt input) at Flying Crabs within 60 m, 200 damage in 6 m. Does not attack ground enemies. Needs power.") },
		{ TEXT("Flüssigen Biotreibstoff verbrennen"), TEXT("Burn Liquid Biofuel") },
		{ TEXT("Forschungspunkt: Aufzeichnungen aus abgewehrten Wellen. Im MAM fuer neue Gebaeude, Munition und Faehigkeiten einsetzen. Es gibt sie nach jeder Welle."), TEXT("Research Point: records from repelled waves. Spend them in the MAM on new buildings, ammo and abilities. You get them after every wave.") },
		{ TEXT("Funkmast"), TEXT("Radio Mast") },
		{ TEXT("Förderband Mk2"), TEXT("Conveyor Belt Mk.2") },
		{ TEXT("Förderband Mk3"), TEXT("Conveyor Belt Mk.3") },
		{ TEXT("Für jede abgewehrte Welle erhalten Sie FICSIT-Coupons. Am Kern tauschen Sie sie gegen Baukontingente, Türme und Reparaturen."), TEXT("For every wave you repel, you earn FICSIT Coupons. Trade them at the Core for build quotas, turrets and repairs.") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Bolzenturm Stufe 2: Durchschlagbolzen + Quarzkristall. Zerfällt in 3 Splitter auf weitere Ziele, stark gegen Schwärme.\n\nGut gegen: Schwärme\nAb Welle: 10\nBraucht: Ballistik > Durchschlagbolzen, Industrie > Quarzverarbeitung\nAbzweigung: schließt Schockbolzen für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Bolt Turret tier 2: Piercing Bolt + Quartz Crystal. Splits into 3 shards that hit further targets, strong against swarms.\n\nGood against: swarms\nFrom wave: 10\nRequires: Ballistics > Piercing Bolt, Industry > Quartz Processing\nBranch: excludes Stun Bolt for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Bolzenturm Stufe 2: Durchschlagbolzen + Turbodraht (Caterium). Strom-Schaden statt Durchschlag und betäubt jeden Getroffenen 3 Sekunden: die Antwort des Bolzenturms auf Stinger.\n\nGut gegen: Stinger, Wasserspucker (Strom)\nAb Welle: 12\nBraucht: Ballistik > Durchschlagbolzen, Industrie > Caterium\nAbzweigung: schließt Streubolzen für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Bolt Turret tier 2: Piercing Bolt + Quickwire (Caterium). Electric damage instead of piercing, and stuns every target hit for 3 seconds: the Bolt Turret's answer to Stingers.\n\nGood against: Stingers, Water Spitters (electric)\nFrom wave: 12\nRequires: Ballistics > Piercing Bolt, Industry > Caterium\nBranch: excludes Shrapnel Bolt for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Der Kern schießt selbst: alle 1,5 s ein Bolzen mit 60 Schaden auf den nächsten Gegner in 30 m. Die letzte Linie, kein Ersatz für Türme."), TEXT("BRANCH: FICSIT funds only one development line per operation. The Core fires on its own: one bolt every 1.5 s dealing 60 damage to the nearest enemy within 30 m. A last line of defense, not a replacement for turrets.") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Der Kern schießt selbst: alle 1,5 s ein Bolzen mit 60 Schaden auf den nächsten Gegner in 30 m. Die letzte Linie, kein Ersatz für Türme.\n\nGut gegen: einzelne Durchbrüche\nAb Welle: 10\nBraucht: Festung > Kern-Panzerung\nAbzweigung: schließt Kern-Schild für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. The Core fires on its own: one bolt every 1.5 s dealing 60 damage to the nearest enemy within 30 m. A last line of defense, not a replacement for turrets.\n\nGood against: single breakthroughs\nFrom wave: 10\nRequires: Fortress > Core Armor\nBranch: excludes Core Shield for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Die ganze Ladung geht in das Hauptziel: Schaden x2,5, dafür keine Sprünge. Stark gegen Elite und Bosse."), TEXT("BRANCH: FICSIT funds only one development line per operation. The whole charge goes into the main target: damage x2.5, but no jumps. Strong against Elites and Bosses.") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Die ganze Ladung geht in das Hauptziel: Schaden x2,5, dafür keine Sprünge. Stark gegen Elite und Bosse.\n\nGut gegen: Elite und Bosse\nAb Welle: 6\nBraucht: Elementar > Teslaspule\nAbzweigung: schließt Kettenblitz für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. The whole charge goes into the main target: damage x2.5, but no jumps. Strong against Elites and Bosses.\n\nGood against: Elites and Bosses\nFrom wave: 6\nRequires: Elemental > Tesla Coil\nBranch: excludes Chain Lightning for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Ein Schild fängt in jeder Welle die ersten 2000 Schaden am Kern ab und lädt sich zum Start der nächsten Welle neu."), TEXT("BRANCH: FICSIT funds only one development line per operation. A shield absorbs the first 2000 damage to the Core each wave and recharges at the start of the next wave.") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Ein Schild fängt in jeder Welle die ersten 2000 Schaden am Kern ab und lädt sich zum Start der nächsten Welle neu.\n\nGut gegen: Durchbrüche am Kern\nAb Welle: 8\nBraucht: Festung > Kern-Panzerung\nAbzweigung: schließt Kern-Geschütz für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. A shield absorbs the first 2000 damage to the Core each wave and recharges at the start of the next wave.\n\nGood against: breakthroughs at the Core\nFrom wave: 8\nRequires: Fortress > Core Armor\nBranch: excludes Core Cannon for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Gewehrturm Stufe 2: 2 Gewehrmunition + Stahlrohr im Assembler. Durchschlag-Schaden statt Kugel: geht durch die Panzerung der Hogs.\n\nGut gegen: Hogs (Panzer)\nAb Welle: 5\nBraucht: Ballistik > Gewehrturm, Industrie > Gießerei und Stahl\nAbzweigung: schließt Zielsuchmunition für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Rifle Turret tier 2: 2 Rifle Ammo + Steel Pipe in the Assembler. Piercing damage instead of bullet damage: goes through the Hogs' armor.\n\nGood against: Hogs (armor)\nFrom wave: 5\nRequires: Ballistics > Rifle Turret, Industry > Foundry and Steel\nBranch: excludes Homing Rifle Ammo for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Gewehrturm Stufe 2: Gewehrmunition + Turbodraht (Caterium). Trifft immer, auch schnelle Ziele, doppelter Schaden je Schuss.\n\nGut gegen: schnelle Stinger\nAb Welle: 12\nBraucht: Ballistik > Gewehrturm, Industrie > Caterium\nAbzweigung: schließt Panzerbrechende Munition für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Rifle Turret tier 2: Rifle Ammo + Quickwire (Caterium). Always hits, even fast targets, double damage per shot.\n\nGood against: fast Stingers\nFrom wave: 12\nRequires: Ballistics > Rifle Turret, Industry > Caterium\nBranch: excludes Armor-Piercing Ammo for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Gewehrturm Stufe 2: Gewehrmunition + Turbodraht (Caterium). Trifft immer, auch schnelle Ziele: 20 statt 12 Schaden je Schuss bei 5 statt 6 Schuss pro Sekunde, Magazin 20 (rund 40 % mehr Schaden pro Sekunde).\n\nGut gegen: schnelle Stinger\nAb Welle: 12\nBraucht: Ballistik > Gewehrturm, Industrie > Caterium\nAbzweigung: schließt Panzerbrechende Munition für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Rifle Turret tier 2: Rifle Ammo + Quickwire (Caterium). Always hits, even fast targets: 20 instead of 12 damage per shot at 5 instead of 6 shots per second, magazine 20 (about 40% more damage per second).\n\nGood against: fast Stingers\nFrom wave: 12\nRequires: Ballistics > Rifle Turret, Industry > Caterium\nBranch: excludes Armor-Piercing Ammo for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Jede Entladung springt 3-mal mehr, also auf bis zu 6 weitere Gegner (höchstens 8 Ziele mit allen Boni). Stark gegen Brut und Schwärme."), TEXT("BRANCH: FICSIT funds only one development line per operation. Each discharge jumps 3 more times, to up to 6 more enemies (at most 8 targets with all bonuses). Strong against broods and swarms.") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Jede Entladung springt 3-mal mehr, also auf bis zu 6 weitere Gegner (höchstens 8 Ziele mit allen Boni). Stark gegen Brut und Schwärme.\n\nGut gegen: Brut und Schwärme\nAb Welle: 6\nBraucht: Elementar > Teslaspule\nAbzweigung: schließt Überlast für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Each discharge jumps 3 more times, to up to 6 more enemies (at most 8 targets with all bonuses). Strong against broods and swarms.\n\nGood against: broods and swarms\nFrom wave: 6\nRequires: Elemental > Tesla Coil\nBranch: excludes Overload for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Jede Entladung springt auf 3 weitere Gegner. Stark gegen Brut und Schwärme."), TEXT("BRANCH: FICSIT funds only one development line per operation. Each discharge jumps to 3 more enemies. Strong against broods and swarms.") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Jede Entladung springt auf 3 weitere Gegner. Stark gegen Brut und Schwärme.\n\nGut gegen: Brut und Schwärme\nAb Welle: 6\nBraucht: Elementar > Teslaspule\nAbzweigung: schließt Überlast für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Each discharge jumps to 3 more enemies. Strong against broods and swarms.\n\nGood against: broods and swarms\nFrom wave: 6\nRequires: Elemental > Tesla Coil\nBranch: excludes Overload for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: Drohnenplatz mit 2 bis 4 Drohnen. Sie fliegen zu beschädigten Mauern, Türmen und Bauten in 40 m und reparieren sie mit Eisenplatten oder verstärkten Platten. Braucht 30 MW.\n\nIm Laden: Drohnenplatz\nGut gegen: lange Wellen\nAb Welle: 40\nBraucht: Festung > Schildgenerator, Industrie > Schwerindustrie\nAbzweigung: schließt Kampfdrohnen für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: Drone Pad with 2 to 4 drones. They fly to damaged walls, turrets and buildings within 40 m and repair them with Iron Plates or Reinforced Iron Plates. Needs 30 MW.\n\nIn the Shop: Drone Pad\nGood against: long waves\nFrom wave: 40\nRequires: Fortress > Shield Generator, Industry > Heavy Industry\nBranch: excludes Combat Drones for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: Drohnenplatz mit 2 bis 4 Drohnen. Sie fliegen über die Front zu Gegnern in 40 m und schießen mit Gewehrmunition, auch auf Fernkämpfer hinter den Mauern. Braucht 30 MW.\n\nIm Laden: Drohnenplatz\nGut gegen: Fernkämpfer und Durchbrüche\nAb Welle: 40\nBraucht: Festung > Schildgenerator, Industrie > Schwerindustrie\nAbzweigung: schließt Reparaturdrohnen für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: Drone Pad with 2 to 4 drones. They fly over the front line to enemies within 40 m and shoot with Rifle Ammo, even at ranged attackers behind the walls. Needs 30 MW.\n\nIn the Shop: Drone Pad\nGood against: ranged attackers and breakthroughs\nFrom wave: 40\nRequires: Fortress > Shield Generator, Industry > Heavy Industry\nBranch: excludes Repair Drones for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: Kuppel 20 m schluckt Schaden an Mauern, Türmen und Bauten (nicht am Kern), 3000 Schildpunkte, gebrochen 20 s Ladezeit. Braucht Schwerindustrie und dauernd 60 MW.\n\nIm Laden: Schildgenerator\nGut gegen: Spucker und Durchbrüche an Bauten\nAb Welle: 25\nBraucht: Festung > Notreparatur, Elementar > Akkubank, Industrie > Schwerindustrie\nAbzweigung: schließt Störfeld-Projektor für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: a 20 m dome absorbs damage to walls, turrets and buildings (not the Core), 3000 shield points, 20 s recharge when broken. Requires Heavy Industry and constantly needs 60 MW.\n\nIn the Shop: Shield Generator\nGood against: Spitters and breakthroughs at buildings\nFrom wave: 25\nRequires: Fortress > Emergency Repair, Elemental > Battery Bank, Industry > Heavy Industry\nBranch: excludes Jammer Projector for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: Kuppel 20 m schluckt Schaden an Mauern, Türmen und Bauten (nicht am Kern), 3000 Schildpunkte, gebrochen 20 s Ladezeit. Braucht dauernd 60 MW.\n\nIm Laden: Schildgenerator\nGut gegen: Spucker und Durchbrüche an Bauten\nAb Welle: 25\nBraucht: Festung > Reparaturstation, Elementar > Akkubank\nAbzweigung: schließt Störfeld-Projektor für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: a 20 m dome absorbs damage to walls, turrets and buildings (not the Core), 3000 shield points, 20 s recharge when broken. Constantly needs 60 MW.\n\nIn the Shop: Shield Generator\nGood against: Spitters and breakthroughs at buildings\nFrom wave: 25\nRequires: Fortress > Repair Station, Elemental > Battery Bank\nBranch: excludes Jammer Projector for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: Mauerstück 8 x 4 m mit Kupferstäben. Für Gegner eine Mauer; wer ihn angreift, bekommt einen Stromschlag (15 Schaden, 1 s Betäubung). Braucht 2 MW.\n\nIm Laden: Elektrozaun\nGut gegen: Gegner an Mauern (Strom)\nAb Welle: 12\nBraucht: Elementar > Teslaspule\nAbzweigung: schließt Ölschlick-Feld für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: 8 x 4 m wall piece with copper rods. A wall to enemies; whoever attacks it gets an electric shock (15 damage, 1 s stun). Needs 2 MW.\n\nIn the Shop: Electric Fence\nGood against: enemies at walls (electric)\nFrom wave: 12\nRequires: Elemental > Tesla Coil\nBranch: excludes Oil Slick Field for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: verbraucht reanimiertes SAM (1 Barren je 60 s), solange Gegner in 15 m sind, und bremst sie alle um 40 %.\n\nIm Laden: Störfeld-Projektor\nGut gegen: Bosse und Massen\nAb Welle: 40\nBraucht: Festung > Turmfertigung IV: Meisterstufe\nAbzweigung: schließt Schildgenerator für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: consumes Reanimated SAM (1 ingot per 60 s) while enemies are within 15 m, and slows them all by 40%.\n\nIn the Shop: Jammer Projector\nGood against: Bosses and masses\nFrom wave: 40\nRequires: Fortress > Turret Fabrication IV: Master Tier\nBranch: excludes Shield Generator for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Neues Gebäude: verbraucht reanimiertes SAM (1 Barren je 60 s), solange Gegner in 15 m sind, und bremst sie alle um 40 %. Braucht Mischtechnik und 80 MW.\n\nIm Laden: Störfeld-Projektor\nGut gegen: Bosse und Massen\nAb Welle: 35\nBraucht: Festung > Turmfertigung IV: Meisterstufe, Industrie > Mischtechnik\nAbzweigung: schließt Schildgenerator für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. New building: consumes Reanimated SAM (1 ingot per 60 s) while enemies are within 15 m, and slows them all by 40%. Requires Blending Technology and 80 MW.\n\nIn the Shop: Jammer Projector\nGood against: Bosses and masses\nFrom wave: 35\nRequires: Fortress > Turret Fabrication IV: Master Tier, Industry > Blending Technology\nBranch: excludes Shield Generator for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Nobelisk + 2 Quarzkristall: Druckwelle, die Gegner zurückwirft und betäubt.\n\nGut gegen: Durchbrüche (zurückwerfen)\nAb Welle: 15\nBraucht: Ballistik > Nobelisk-Werfer, Industrie > Quarzverarbeitung\nAbzweigung: schließt Gas-Nobelisk für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Nobelisk + 2 Quartz Crystal: a shockwave that knocks enemies back and stuns them.\n\nGood against: breakthroughs (knockback)\nFrom wave: 15\nRequires: Ballistics > Nobelisk Launcher, Industry > Quartz Processing\nBranch: excludes Gas Nobelisk for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Nobelisk + 2 Quarzkristall: Druckwelle, die alle Gegner im Umkreis 2 s betäubt.\n\nGut gegen: Durchbrüche (betäuben)\nAb Welle: 15\nBraucht: Ballistik > Nobelisk-Werfer, Industrie > Quarzverarbeitung\nAbzweigung: schließt Gas-Nobelisk für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Nobelisk + 2 Quartz Crystal: a shockwave that stuns all enemies in the area for 2 s.\n\nGood against: breakthroughs (stun)\nFrom wave: 15\nRequires: Ballistics > Nobelisk Launcher, Industry > Quartz Processing\nBranch: excludes Gas Nobelisk for this operation") },
		{ TEXT("GABELUNG: FICSIT finanziert je Einsatz nur eine Entwicklungslinie. Nobelisk + 2 Schwefel: Giftwolke, die Gegner darin über Zeit schädigt. Gift-Schaden, gegen den keine Gegnerart geschützt ist.\n\nGut gegen: dichte Pulks, Stinger (Gift)\nAb Welle: 15\nBraucht: Ballistik > Nobelisk-Werfer\nAbzweigung: schließt Puls-Nobelisk für diesen Einsatz aus"), TEXT("BRANCH: FICSIT funds only one development line per operation. Nobelisk + 2 Sulfur: a toxic cloud that damages enemies inside it over time. Poison damage that no enemy type is protected against.\n\nGood against: dense packs, Stingers (poison)\nFrom wave: 15\nRequires: Ballistics > Nobelisk Launcher\nBranch: excludes Pulse Nobelisk for this operation") },
		{ TEXT("Gas-Nobelisk"), TEXT("Gas Nobelisk") },
		{ TEXT("Gas-Nobelisk (FICSIT)"), TEXT("Gas Nobelisk (FICSIT)") },
		{ TEXT("Gas-Nobelisk abfeuern"), TEXT("Fire Gas Nobelisk") },
		{ TEXT("Gegner, die das Lockfeuer festhält, stehen dicht: Explosionen treffen sie 25 % härter."), TEXT("Enemies held by the Lure Fire stand close together: explosions hit them 25% harder.") },
		{ TEXT("Gegner, die eine Mauer angreifen, nehmen ein Viertel ihres Schadens selbst (mindestens 15)."), TEXT("Enemies attacking a wall take a quarter of their damage themselves (at least 15).") },
		{ TEXT("Gegner, die eine Mauer angreifen, nehmen ein Viertel ihres Schadens selbst (mindestens 15).\n\nGut gegen: Gegner an Mauern\nAb Welle: 12\nBraucht: Festung > Verstärkte Mauern"), TEXT("Enemies attacking a wall take a quarter of their damage themselves (at least 15).\n\nGood against: enemies at walls\nFrom wave: 12\nRequires: Fortress > Reinforced Walls") },
		{ TEXT("Gehaerteter Bolzen mit Schraubspitze: durchschlaegt das erste Ziel und trifft bis zu zwei weitere Gegner in der Schusslinie. Munition fuer den Bolzenturm."), TEXT("Hardened bolt with a screw tip: pierces the first target and hits up to two more enemies in the line of fire. Ammo for the Bolt Turret.") },
		{ TEXT("Gewehrmunition (FICSIT)"), TEXT("Rifle Ammo (FICSIT)") },
		{ TEXT("Gewehrmunition laden (15 Schuss)"), TEXT("Load Rifle Ammo (15 rounds)") },
		{ TEXT("Gewehrmunition mit Brandsatz: jeder Treffer setzt das Ziel kurz in Brand (zusätzlicher Feuer-Schaden). Munition für den Gewehrturm."), TEXT("Rifle Ammo with an incendiary charge: every hit briefly sets the target on fire (extra fire damage). Ammo for the Rifle Turret.") },
		{ TEXT("Gewehrmunition mit Stahlkern: macht Durchschlag-Schaden statt Kugel-Schaden und geht durch die Panzerung der Hogs. Munition für den Gewehrturm."), TEXT("Rifle Ammo with a steel core: deals piercing damage instead of bullet damage and goes through the Hogs' armor. Ammo for the Rifle Turret.") },
		{ TEXT("Gewehrturm"), TEXT("Rifle Turret") },
		{ TEXT("Gewehrturm Stufe 2: 2 Gewehrmunition + Schwefel im Assembler. Jeder Treffer setzt das Ziel kurz in Brand (zusätzlicher Feuer-Schaden).\n\nGut gegen: Waldspucker (Feuer)\nAb Welle: 15\nBraucht: Ballistik > Gewehrturm, Industrie > Schwefel"), TEXT("Rifle Turret tier 2: 2 Rifle Ammo + Sulfur in the Assembler. Every hit briefly sets the target on fire (extra fire damage).\n\nGood against: Forest Spitters (fire)\nFrom wave: 15\nRequires: Ballistics > Rifle Turret, Industry > Sulfur") },
		{ TEXT("Gewehrturm Stufe 3 (spät): 2 Gewehrmunition + Aluminiumgehäuse. Doppelte Feuerrate, Magazin mit 75 Schuss.\n\nGut gegen: Massen\nAb Welle: 25\nBraucht: Ballistik > Brandmunition, Industrie > Bauxit und Aluminium"), TEXT("Rifle Turret tier 3 (late): 2 Rifle Ammo + Aluminum Casing. Double fire rate, magazine with 75 rounds.\n\nGood against: masses\nFrom wave: 25\nRequires: Ballistics > Incendiary Ammo, Industry > Bauxite and Aluminum") },
		{ TEXT("Gewehrturm: Aktion"), TEXT("Rifle Turret: Action") },
		{ TEXT("Gießerei (im Laden kaufbar), Stahlbarren aus Eisenerz und Kohle, Stahlrohre und Stahlträger. Für Nobelisken, Turbomunition und Band Mk3.\n\nIm Laden: Gießerei\nBraucht: Industrie > Assembler und Eisenteile"), TEXT("Foundry (available in the Shop), Steel Ingot from Iron Ore and Coal, Steel Pipes and Steel Beams. For Nobelisks, Turbo Rifle Ammo and Belt Mk.3.\n\nIn the Shop: Foundry\nRequires: Industry > Assembler and Iron Parts") },
		{ TEXT("Gießerei und Stahl"), TEXT("Foundry and Steel") },
		{ TEXT("Hauptlinie Bolzenturm: +25 % Schaden"), TEXT("Bolt Turret main line: +25% damage") },
		{ TEXT("Hauptlinie Flammenwerfer: +25 % Schaden"), TEXT("Flamethrower main line: +25% damage") },
		{ TEXT("Hauptlinie Gewehrturm: +25 % Schaden"), TEXT("Rifle Turret main line: +25% damage") },
