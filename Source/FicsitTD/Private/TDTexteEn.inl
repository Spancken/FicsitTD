		{ TEXT("1 Aluminiumgehäuse + 2 Schwarzpulver ergibt 2 Flak-Kanister in 6 s (20 pro Minute) im Fabrikator (Assembler).\nAluminiumgehäuse: 3 Aluminiumbarren im Konstruktor (Forschung Bauxit und Aluminium).\nSchwarzpulver: 1 Kohle + 1 Schwefel im Fabrikator (Assembler) (Forschung Nobelisk-Werfer).\nPer Förderband oder Rohr in den Himmelsturm."), TEXT("1 Aluminum Casing + 2 Black Powder makes 2 Flak Canister in 6 s (20 per minute) in the Assembler.\nAluminum Casing: 3 Aluminum Ingot in the Constructor (Research: Bauxite and Aluminum).\nBlack Powder: 1 Coal + 1 Sulfur in the Assembler (Research: Nobelisk Launcher).\nFeed into the Sky Tower by conveyor belt or pipe.") },
		{ TEXT("1 Gewehrmunition + 1 Turbodraht ergibt 1 Zielsuch-Gewehrmunition in 6 s (10 pro Minute) im Fabrikator (Assembler).\nGewehrmunition: 1 Kupferblech + 1 Eisenstange im Fabrikator (Assembler) (Forschung Gewehrturm).\nTurbodraht: 1 Caterium-Barren im Konstruktor (Forschung Caterium).\nPer Förderband oder Rohr in den Gewehrturm."), TEXT("1 Rifle Ammo + 1 Quickwire makes 1 Homing Rifle Ammo in 6 s (10 per minute) in the Assembler.\nRifle Ammo: 1 Copper Sheet + 1 Iron Rod in the Assembler (Research: Rifle Turret).\nQuickwire: 1 Caterium Ingot in the Constructor (Research: Caterium).\nFeed into the Rifle Turret by conveyor belt or pipe.") },
		{ TEXT("1 Kupferblech + 1 Eisenstange ergibt 1 Gewehrmunition in 4 s (15 pro Minute) im Fabrikator (Assembler).\nKupferblech: 2 Kupferbarren im Konstruktor (Forschung Kupferverarbeitung).\nPer Förderband oder Rohr in den Drohnenplatz."), TEXT("1 Copper Sheet + 1 Iron Rod makes 1 Rifle Ammo in 4 s (15 per minute) in the Assembler.\nCopper Sheet: 2 Copper Ingot in the Constructor (Research: Copper Processing).\nFeed into the Drone Pad by conveyor belt or pipe.") },
		{ TEXT("1 Kupferblech + 1 Eisenstange ergibt 1 Gewehrmunition in 4 s (15 pro Minute) im Fabrikator (Assembler).\nKupferblech: 2 Kupferbarren im Konstruktor (Forschung Kupferverarbeitung).\nPer Förderband oder Rohr in den Gewehrturm."), TEXT("1 Copper Sheet + 1 Iron Rod makes 1 Rifle Ammo in 4 s (15 per minute) in the Assembler.\nCopper Sheet: 2 Copper Ingot in the Constructor (Research: Copper Processing).\nFeed into the Rifle Turret by conveyor belt or pipe.") },
		{ TEXT("1 Nobelisk + 2 Quarzkristall ergibt 1 Impuls-Nobelisk in 6 s (10 pro Minute) im Fabrikator (Assembler).\nNobelisk: 2 Schwarzpulver + 1 Stahlrohr im Fabrikator (Assembler) (Forschung Nobelisk-Werfer).\nQuarzkristall: 5 Rohquarz im Konstruktor (Forschung Quarzverarbeitung).\nPer Förderband oder Rohr in den Nobelisk-Werfer."), TEXT("1 Nobelisk + 2 Quartz Crystal makes 1 Pulse Nobelisk in 6 s (10 per minute) in the Assembler.\nNobelisk: 2 Black Powder + 1 Steel Pipe in the Assembler (Research: Nobelisk Launcher).\nQuartz Crystal: 5 Raw Quartz in the Constructor (Research: Quartz Processing).\nFeed into the Nobelisk Launcher by conveyor belt or pipe.") },
		{ TEXT("1 Nobelisk + 2 Schwefel ergibt 1 Gas-Nobelisk in 6 s (10 pro Minute) im Fabrikator (Assembler).\nNobelisk: 2 Schwarzpulver + 1 Stahlrohr im Fabrikator (Assembler) (Forschung Nobelisk-Werfer).\nPer Förderband oder Rohr in den Nobelisk-Werfer."), TEXT("1 Nobelisk + 2 Sulfur makes 1 Gas Nobelisk in 6 s (10 per minute) in the Assembler.\nNobelisk: 2 Black Powder + 1 Steel Pipe in the Assembler (Research: Nobelisk Launcher).\nFeed into the Nobelisk Launcher by conveyor belt or pipe.") },
		{ TEXT("16 m³ Raketentreibstoff + 1 Energiefragment ergibt 16 m³ Ionisierter Treibstoff in 24 s (40 m³ pro Minute) in der Raffinerie.\nRaketentreibstoff: 6 m³ Turbotreibstoff + 1 m³ Salpetersäure im Mischer (Forschung Raketentreibstoff).\nPer Förderband oder Rohr in den Flammenwerfer."), TEXT("16 m³ Rocket Fuel + 1 Power Shard makes 16 m³ Ionized Fuel in 24 s (40 m³ per minute) in the Refinery.\nRocket Fuel: 6 m³ Turbofuel + 1 m³ Nitric Acid in the Blender (Research: Rocket Fuel).\nFeed into the Flamethrower by conveyor belt or pipe.") },
		{ TEXT("2 Armierungsbolzen + 4 Schrauben ergibt 2 Durchschlagbolzen in 8 s (15 pro Minute) im Fabrikator (Assembler).\nSchrauben: 1 Eisenstange im Konstruktor (Forschung Assembler und Eisenteile).\nPer Förderband oder Rohr in den Bolzenturm."), TEXT("2 Rebar Bolt + 4 Screws makes 2 Piercing Bolt in 8 s (15 per minute) in the Assembler.\nScrews: 1 Iron Rod in the Constructor (Research: Assembler and Iron Parts).\nFeed into the Bolt Turret by conveyor belt or pipe.") },
		{ TEXT("2 Durchschlagbolzen + 1 Quarzkristall ergibt 2 Splitterbolzen in 8 s (15 pro Minute) im Fabrikator (Assembler).\nDurchschlagbolzen: 2 Armierungsbolzen + 4 Schrauben im Fabrikator (Assembler) (Forschung Durchschlagbolzen).\nQuarzkristall: 5 Rohquarz im Konstruktor (Forschung Quarzverarbeitung).\nPer Förderband oder Rohr in den Bolzenturm."), TEXT("2 Piercing Bolt + 1 Quartz Crystal makes 2 Shrapnel Bolt in 8 s (15 per minute) in the Assembler.\nPiercing Bolt: 2 Rebar Bolt + 4 Screws in the Assembler (Research: Piercing Bolt).\nQuartz Crystal: 5 Raw Quartz in the Constructor (Research: Quartz Processing).\nFeed into the Bolt Turret by conveyor belt or pipe.") },
		{ TEXT("2 Durchschlagbolzen + 1 Rauchschwaches Pulver ergibt 2 Explosionsbolzen in 8 s (15 pro Minute) im Fabrikator (Assembler).\nDurchschlagbolzen: 2 Armierungsbolzen + 4 Schrauben im Fabrikator (Assembler) (Forschung Durchschlagbolzen).\nRauchschwaches Pulver: 2 Schwarzpulver + 1 m³ Schwerölrückstand in der Raffinerie (Forschung Explosivbolzen).\nPer Förderband oder Rohr in den Bolzenturm."), TEXT("2 Piercing Bolt + 1 Smokeless Powder makes 2 Explosive Bolt in 8 s (15 per minute) in the Assembler.\nPiercing Bolt: 2 Rebar Bolt + 4 Screws in the Assembler (Research: Piercing Bolt).\nSmokeless Powder: 2 Black Powder + 1 m³ Heavy Oil Residue in the Refinery (Research: Explosive Bolt).\nFeed into the Bolt Turret by conveyor belt or pipe.") },
		{ TEXT("2 Durchschlagbolzen + 2 Turbodraht ergibt 2 Betäubungsbolzen in 8 s (15 pro Minute) im Fabrikator (Assembler).\nDurchschlagbolzen: 2 Armierungsbolzen + 4 Schrauben im Fabrikator (Assembler) (Forschung Durchschlagbolzen).\nTurbodraht: 1 Caterium-Barren im Konstruktor (Forschung Caterium).\nPer Förderband oder Rohr in den Bolzenturm."), TEXT("2 Piercing Bolt + 2 Quickwire makes 2 Stun Bolt in 8 s (15 per minute) in the Assembler.\nPiercing Bolt: 2 Rebar Bolt + 4 Screws in the Assembler (Research: Piercing Bolt).\nQuickwire: 1 Caterium Ingot in the Constructor (Research: Caterium).\nFeed into the Bolt Turret by conveyor belt or pipe.") },
		{ TEXT("2 Gewehrmunition + 1 Aluminiumgehäuse ergibt 2 Turbo-Gewehrmunition in 8 s (15 pro Minute) im Fabrikator (Assembler).\nGewehrmunition: 1 Kupferblech + 1 Eisenstange im Fabrikator (Assembler) (Forschung Gewehrturm).\nAluminiumgehäuse: 3 Aluminiumbarren im Konstruktor (Forschung Bauxit und Aluminium).\nPer Förderband oder Rohr in den Gewehrturm."), TEXT("2 Rifle Ammo + 1 Aluminum Casing makes 2 Turbo Rifle Ammo in 8 s (15 per minute) in the Assembler.\nRifle Ammo: 1 Copper Sheet + 1 Iron Rod in the Assembler (Research: Rifle Turret).\nAluminum Casing: 3 Aluminum Ingot in the Constructor (Research: Bauxite and Aluminum).\nFeed into the Rifle Turret by conveyor belt or pipe.") },
		{ TEXT("2 Gewehrmunition + 1 Schwefel ergibt 2 Brandmunition in 8 s (15 pro Minute) im Fabrikator (Assembler).\nGewehrmunition: 1 Kupferblech + 1 Eisenstange im Fabrikator (Assembler) (Forschung Gewehrturm).\nPer Förderband oder Rohr in den Gewehrturm."), TEXT("2 Rifle Ammo + 1 Sulfur makes 2 Incendiary Ammo in 8 s (15 per minute) in the Assembler.\nRifle Ammo: 1 Copper Sheet + 1 Iron Rod in the Assembler (Research: Rifle Turret).\nFeed into the Rifle Turret by conveyor belt or pipe.") },
		{ TEXT("2 Gewehrmunition + 1 Stahlrohr ergibt 2 Panzerbrechende Munition in 8 s (15 pro Minute) im Fabrikator (Assembler).\nGewehrmunition: 1 Kupferblech + 1 Eisenstange im Fabrikator (Assembler) (Forschung Gewehrturm).\nStahlrohr: 3 Stahlbarren im Konstruktor (Forschung Gießerei und Stahl).\nPer Förderband oder Rohr in den Gewehrturm."), TEXT("2 Rifle Ammo + 1 Steel Pipe makes 2 Armor-Piercing Ammo in 8 s (15 per minute) in the Assembler.\nRifle Ammo: 1 Copper Sheet + 1 Iron Rod in the Assembler (Research: Rifle Turret).\nSteel Pipe: 3 Steel Ingot in the Constructor (Research: Foundry and Steel).\nFeed into the Rifle Turret by conveyor belt or pipe.") },
		{ TEXT("2 Nobelisk + 2 Rauchschwaches Pulver ergibt 1 Splitter-Nobelisk in 8 s (8 pro Minute) im Fabrikator (Assembler).\nNobelisk: 2 Schwarzpulver + 1 Stahlrohr im Fabrikator (Assembler) (Forschung Nobelisk-Werfer).\nRauchschwaches Pulver: 2 Schwarzpulver + 1 m³ Schwerölrückstand in der Raffinerie (Forschung Explosivbolzen).\nPer Förderband oder Rohr in den Nobelisk-Werfer."), TEXT("2 Nobelisk + 2 Smokeless Powder makes 1 Cluster Nobelisk in 8 s (8 per minute) in the Assembler.\nNobelisk: 2 Black Powder + 1 Steel Pipe in the Assembler (Research: Nobelisk Launcher).\nSmokeless Powder: 2 Black Powder + 1 m³ Heavy Oil Residue in the Refinery (Research: Explosive Bolt).\nFeed into the Nobelisk Launcher by conveyor belt or pipe.") },
		{ TEXT("2 Schwarzpulver + 1 Stahlrohr ergibt 1 Nobelisk in 6 s (10 pro Minute) im Fabrikator (Assembler).\nSchwarzpulver: 1 Kohle + 1 Schwefel im Fabrikator (Assembler) (Forschung Nobelisk-Werfer).\nStahlrohr: 3 Stahlbarren im Konstruktor (Forschung Gießerei und Stahl).\nPer Förderband oder Rohr in den Nobelisk-Werfer."), TEXT("2 Black Powder + 1 Steel Pipe makes 1 Nobelisk in 6 s (10 per minute) in the Assembler.\nBlack Powder: 1 Coal + 1 Sulfur in the Assembler (Research: Nobelisk Launcher).\nSteel Pipe: 3 Steel Ingot in the Constructor (Research: Foundry and Steel).\nFeed into the Nobelisk Launcher by conveyor belt or pipe.") },
		{ TEXT("3 Eisenbarren ergibt 2 Eisenplatte in 6 s (20 pro Minute) im Konstruktor.\nPer Förderband oder Rohr in den Drohnenplatz."), TEXT("3 Iron Ingot makes 2 Iron Plate in 6 s (20 per minute) in the Constructor.\nFeed into the Drone Pad by conveyor belt or pipe.") },
		{ TEXT("3 Eisenbarren ergibt 2 Eisenplatte in 6 s (20 pro Minute) im Konstruktor.\nPer Förderband oder Rohr in den Reparaturstation."), TEXT("3 Iron Ingot makes 2 Iron Plate in 6 s (20 per minute) in the Constructor.\nFeed into the Repair Station by conveyor belt or pipe.") },
		{ TEXT("3 m³ Rohöl ergibt 1 m³ Schwerölrückstand in 6 s (10 m³ pro Minute) in der Raffinerie.\nPer Förderband oder Rohr in den Oelschlick-Feld."), TEXT("3 m³ Crude Oil makes 1 m³ Heavy Oil Residue in 6 s (10 m³ per minute) in the Refinery.\nFeed into the Oil Slick Field by conveyor belt or pipe.") },
		{ TEXT("4 SAM ergibt 1 Reanimierte SAM in 2 s (30 pro Minute) im Konstruktor.\nPer Förderband oder Rohr in den Stoerfeld-Projektor."), TEXT("4 SAM makes 1 Reanimated SAM in 2 s (30 per minute) in the Constructor.\nFeed into the Jammer Projector by conveyor belt or pipe.") },
		{ TEXT("5 Kohle + 5 Schwefel ergibt 5 Verdichtete Kohle in 12 s (25 pro Minute) im Fabrikator (Assembler).\nPer Förderband oder Rohr in den Lockfeuer."), TEXT("5 Coal + 5 Sulfur makes 5 Compacted Coal in 12 s (25 per minute) in the Assembler.\nFeed into the Lure Fire by conveyor belt or pipe.") },
		{ TEXT("6 Eisenplatte + 12 Schrauben ergibt 1 Verstärkte Eisenplatte in 12 s (5 pro Minute) im Fabrikator (Assembler).\nEisenplatte: 3 Eisenbarren im Konstruktor (Forschung Assembler und Eisenteile).\nSchrauben: 1 Eisenstange im Konstruktor (Forschung Assembler und Eisenteile).\nPer Förderband oder Rohr in den Drohnenplatz."), TEXT("6 Iron Plate + 12 Screws makes 1 Reinforced Iron Plate in 12 s (5 per minute) in the Assembler.\nIron Plate: 3 Iron Ingot in the Constructor (Research: Assembler and Iron Parts).\nScrews: 1 Iron Rod in the Constructor (Research: Assembler and Iron Parts).\nFeed into the Drone Pad by conveyor belt or pipe.") },
		{ TEXT("6 Eisenplatte + 12 Schrauben ergibt 1 Verstärkte Eisenplatte in 12 s (5 pro Minute) im Fabrikator (Assembler).\nEisenplatte: 3 Eisenbarren im Konstruktor (Forschung Assembler und Eisenteile).\nSchrauben: 1 Eisenstange im Konstruktor (Forschung Assembler und Eisenteile).\nPer Förderband oder Rohr in den Reparaturstation."), TEXT("6 Iron Plate + 12 Screws makes 1 Reinforced Iron Plate in 12 s (5 per minute) in the Assembler.\nIron Plate: 3 Iron Ingot in the Constructor (Research: Assembler and Iron Parts).\nScrews: 1 Iron Rod in the Constructor (Research: Assembler and Iron Parts).\nFeed into the Repair Station by conveyor belt or pipe.") },
		{ TEXT("6 m³ Rohöl ergibt 4 m³ Treibstoff in 6 s (40 m³ pro Minute) in der Raffinerie.\nPer Förderband oder Rohr in den Flammenwerfer."), TEXT("6 m³ Crude Oil makes 4 m³ Fuel in 6 s (40 m³ per minute) in the Refinery.\nFeed into the Flamethrower by conveyor belt or pipe.") },
		{ TEXT("6 m³ Treibstoff + 4 Verdichtete Kohle ergibt 5 m³ Turbotreibstoff in 16 s (18,75 m³ pro Minute) in der Raffinerie.\nTreibstoff: 6 m³ Rohöl in der Raffinerie (Forschung Treibstoffkraftwerk).\nVerdichtete Kohle: 5 Kohle + 5 Schwefel im Fabrikator (Assembler) (Forschung Turbotreibstoff).\nPer Förderband oder Rohr in den Flammenwerfer."), TEXT("6 m³ Fuel + 4 Compacted Coal makes 5 m³ Turbofuel in 16 s (18.75 m³ per minute) in the Refinery.\nFuel: 6 m³ Crude Oil in the Refinery (Research: Fuel Power).\nCompacted Coal: 5 Coal + 5 Sulfur in the Assembler (Research: Turbofuel).\nFeed into the Flamethrower by conveyor belt or pipe.") },
		{ TEXT("6 m³ Turbotreibstoff + 1 m³ Salpetersäure ergibt 10 m³ Raketentreibstoff in 6 s (100 m³ pro Minute) im Mischer.\nTurbotreibstoff: 6 m³ Treibstoff + 4 Verdichtete Kohle in der Raffinerie (Forschung Turbotreibstoff).\nSalpetersäure: 12 m³ Stickstoffgas + 3 m³ Wasser + 1 Eisenplatte im Mischer (Forschung Raketentreibstoff).\nPer Förderband oder Rohr in den Flammenwerfer."), TEXT("6 m³ Turbofuel + 1 m³ Nitric Acid makes 10 m³ Rocket Fuel in 6 s (100 m³ per minute) in the Blender.\nTurbofuel: 6 m³ Fuel + 4 Compacted Coal in the Refinery (Research: Turbofuel).\nNitric Acid: 12 m³ Nitrogen Gas + 3 m³ Water + 1 Iron Plate in the Blender (Research: Rocket Fuel).\nFeed into the Flamethrower by conveyor belt or pipe.") },
