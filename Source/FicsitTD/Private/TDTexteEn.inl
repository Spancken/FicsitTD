		{ TEXT("Kern-Schild"), TEXT("Core Shield") },
		{ TEXT("Kettenblitz"), TEXT("Chain Lightning") },
		{ TEXT("Kohlekraftwerk"), TEXT("Coal Power") },
		{ TEXT("Kohlekraftwerk (75 MW statt 30 MW), Wasserextraktor und Rohre. Voraussetzung für Teslaspule und Flammenwerfer.\n\nIm Laden: Kohlekraftwerk, Wasserpumpe\nAb Welle: 6"), TEXT("Coal-Powered Generator (75 MW instead of 30 MW), Water Extractor and pipes. Prerequisite for the Tesla Coil and Flamethrower.\n\nIn the Shop: Coal-Powered Generator, Water Extractor\nFrom wave: 6") },
		{ TEXT("Kohlekraftwerk (75 MW statt 30 MW), Wasserextraktor und Rohre. Öffnet den Baum Elementar (Teslaspule, Flammenwerfer).\n\nIm Laden: Kohlekraftwerk, Wasserpumpe\nAb Welle: 6"), TEXT("Coal-Powered Generator (75 MW instead of 30 MW), Water Extractor and pipes. Unlocks the Elemental tree (Tesla Coil, Flamethrower).\n\nIn the Shop: Coal-Powered Generator, Water Extractor\nFrom wave: 6") },
		{ TEXT("Kombination: Blitzableiter mit Bolzenturm"), TEXT("Combo: Lightning Rod with Bolt Turret") },
		{ TEXT("Kombination: Engstelle mit Bolzenturm"), TEXT("Combo: Chokepoint with Bolt Turret") },
		{ TEXT("Kombination: Hitzeriss mit Bolzen- und Gewehrturm"), TEXT("Combo: Heat Crack with Bolt and Rifle Turret") },
		{ TEXT("Kombination: Leiter mit Teslaspule"), TEXT("Combo: Conductor with Tesla Coil") },
		{ TEXT("Kombination: Sammelpunkt mit Nobelisk-Werfer"), TEXT("Combo: Rally Point with Nobelisk Launcher") },
		{ TEXT("Kombination: Verpuffung mit Flammenwerfer"), TEXT("Combo: Deflagration with Flamethrower") },
		{ TEXT("Kombination: Verpuffung mit Gas-Nobelisk"), TEXT("Combo: Deflagration with Gas Nobelisk") },
		{ TEXT("Kombination: Ölbrand mit Flammenwerfer, Brandmunition, Lockfeuer"), TEXT("Combo: Oil Fire with Flamethrower, Incendiary Ammo, Lure Fire") },
		{ TEXT("Kompaktkohle (FICSIT)"), TEXT("Compacted Coal (FICSIT)") },
		{ TEXT("Kupferbarren, Draht, Kabel und Kupferblech: der zweite Rohstoff. Für Gewehrmunition, Schockbolzen und Stromtechnik."), TEXT("Copper Ingot, Wire, Cable and Copper Sheet: the second resource. For Rifle Ammo, Stun Bolts and electrical tech.") },
		{ TEXT("Kupferverarbeitung"), TEXT("Copper Processing") },
		{ TEXT("Kuppel 20 m: schluckt Schaden an Mauern, Tuermen und Bauten (nicht am Abwehrkern), 3000 Schildpunkte. Gebrochen laedt er 20 s nach. Braucht dauernd Strom (60 MW)."), TEXT("20 m dome: absorbs damage to walls, turrets and buildings (not the Defense Core), 3000 shield points. When broken, it recharges for 20 s. Constantly needs power (60 MW).") },
		{ TEXT("Kurze Reichweite, trifft alle Gegner im Flammenkegel und setzt sie in Brand. Treibstoff per Rohr (Anschluss hinten), braucht Strom."), TEXT("Short range, hits all enemies in the flame cone and sets them on fire. Fuel by pipe (connector at the back), needs power.") },
		{ TEXT("Laedt sich mit viel Strom auf und entlaedt sich in einem Blitz, der auf weitere Gegner ueberspringt. Braucht keine Munition."), TEXT("Charges up with a lot of power and discharges in a lightning bolt that jumps to further enemies. Needs no ammo.") },
		{ TEXT("Lager mit Mercer-Kugel: verteilt seinen Inhalt jede Sekunde an die Tuerme in 30 m, deren Rezept genau diesen Gegenstand verbraucht. Munition ohne Foerderband."), TEXT("Storage with a Mercer Sphere: every second it distributes its contents to the turrets within 30 m whose recipe consumes exactly that item. Ammo without conveyor belts.") },
		{ TEXT("Landeplattform mit 2 bis 4 Drohnen (Level 3 und 5 je eine mehr). Reparaturdrohnen fliegen zu beschaedigten Bauten in 40 m und reparieren sie mit Platten, Kampfdrohnen fliegen zu Gegnern in 40 m und schiessen mit Gewehrmunition. Braucht 30 MW."), TEXT("Landing pad with 2 to 4 drones (one more at level 3 and 5). Repair drones fly to damaged buildings within 40 m and repair them with plates, combat drones fly to enemies within 40 m and shoot with Rifle Ammo. Needs 30 MW.") },
		{ TEXT("Level 5 mit Meisterfähigkeit"), TEXT("Level 5 with master ability") },
		{ TEXT("Lockfeuer"), TEXT("Lure Fire") },
		{ TEXT("Lockruf mit Kohle (15 s)"), TEXT("Lure with Coal (15 s)") },
		{ TEXT("Lockruf mit Kompaktkohle (15 s)"), TEXT("Lure with Compacted Coal (15 s)") },
		{ TEXT("Mauer mit Lebenspunkten. Gegnerwellen greifen sie an; bei 0 Lebenspunkten wird sie zerstoert. Nicht durchlaufbar."), TEXT("Wall with health. Enemy waves attack it; at 0 health it is destroyed. Cannot be walked through.") },
		{ TEXT("Mauern"), TEXT("Walls") },
		{ TEXT("Mauern LP x2"), TEXT("Walls HP x2") },
		{ TEXT("Mauerstueck 8 x 4 m mit Kupferstaeben. Fuer Gegner eine Mauer; wer ihn angreift, bekommt einen Stromschlag (15 Schaden, 1 s Betaeubung). Braucht Strom (2 MW), ohne Strom nur Mauer."), TEXT("8 x 4 m wall piece with copper rods. A wall to enemies; whoever attacks it gets an electric shock (15 damage, 1 s stun). Needs power (2 MW), without power it is just a wall.") },
		{ TEXT("Mischer, Abfüller und Ressourcenbrunnen für Stickstoff (im Laden kaufbar), Fusionierte Modulare Rahmen und SAM-Fluktuatoren. Damit wird der Störfeld-Projektor baubar. Der Druckerzeuger des Ressourcenbrunnens braucht 150 MW: ein Treibstoffkraftwerk einplanen.\n\nIm Laden: Mischer, Abfüller, Ressourcenbrunnen\nAb Welle: 35\nBraucht: Industrie > Schwerindustrie"), TEXT("Blender, Packager and Resource Well for Nitrogen (available in the Shop), Fused Modular Frames and SAM Fluctuators. Makes the Jammer Projector buildable. The Resource Well Pressurizer needs 150 MW: plan for a Fuel-Powered Generator.\n\nIn the Shop: Blender, Packager, Resource Well\nFrom wave: 35\nRequires: Industry > Heavy Industry") },
		{ TEXT("Mischtechnik"), TEXT("Blending Technology") },
		{ TEXT("Munitionspuffer"), TEXT("Ammo Buffer") },
		{ TEXT("Nach jeder abgewehrten Welle repariert sich der Kern um 10 % seiner Lebenspunkte."), TEXT("After each repelled wave, the Core repairs 10% of its health.") },
		{ TEXT("Nach jeder abgewehrten Welle repariert sich der Kern um 10 % seiner Lebenspunkte.\n\nBraucht: Festung > Kern-Panzerung"), TEXT("After each repelled wave, the Core repairs 10% of its health.\n\nRequires: Fortress > Core Armor") },
		{ TEXT("Neuer Turm (Endspiel): Ficsonium-Ladung hält alle Gegner in 12 m fest und sprengt sie nach 1,5 s mit 1500 Explosionsschaden. Ficsonium aus dem Teilchenbeschleuniger.\n\nIm Laden: Singularitätswerfer\nGut gegen: Endwellen\nAb Welle: 45\nBraucht: Ballistik > Himmelsturm, Festung > Turmfertigung IV: Meisterstufe"), TEXT("New turret (endgame): a Ficsonium charge holds all enemies within 12 m and blows them up after 1.5 s with 1500 explosion damage. Ficsonium comes from the Particle Accelerator.\n\nIn the Shop: Singularity Launcher\nGood against: final waves\nFrom wave: 45\nRequires: Ballistics > Sky Tower, Fortress > Turret Fabrication IV: Master Tier") },
		{ TEXT("Neuer Turm (Endspiel): Ficsonium-Ladung hält alle Gegner in 12 m fest und sprengt sie nach 1,5 s mit 1500 Explosionsschaden. Ficsonium aus dem Teilchenbeschleuniger. Erst in den Überstunden (ab Welle 51). Braucht 150 MW.\n\nIm Laden: Singularitätswerfer\nGut gegen: Endwellen\nAb Welle: 51\nBraucht: Ballistik > Himmelsturm, Festung > Turmfertigung IV: Meisterstufe"), TEXT("New turret (endgame): a Ficsonium charge holds all enemies within 12 m and blows them up after 1.5 s with 1500 explosion damage. Ficsonium comes from the Particle Accelerator. Only in Overtime (from wave 51). Needs 150 MW.\n\nIn the Shop: Singularity Launcher\nGood against: final waves\nFrom wave: 51\nRequires: Ballistics > Sky Tower, Fortress > Turret Fabrication IV: Master Tier") },
		{ TEXT("Neuer Turm mit Dauerfeuer, stark gegen flinke Gegner. Munition: Kupferblech + Eisenstange im Assembler. Level 2 im Turmfenster ist damit freigeschaltet.\n\nIm Laden: Gewehrturm\nGut gegen: schnelle Gegner (Stinger)\nAb Welle: 5\nBraucht: Industrie > Assembler und Eisenteile, Industrie > Kupferverarbeitung"), TEXT("New turret with sustained fire, strong against agile enemies. Ammo: Copper Sheet + Iron Rod in the Assembler. This also unlocks Level 2 in the turret window.\n\nIn the Shop: Rifle Turret\nGood against: fast enemies (Stingers)\nFrom wave: 5\nRequires: Industry > Assembler and Iron Parts, Industry > Copper Processing") },
		{ TEXT("Neuer Turm: Flammenkegel mit Nachbrennen, trifft alles im Kegel. Treibstoff aus Rohöl (Ölpumpe, Raffinerie) per Rohr. Level 2 im Turmfenster ist damit freigeschaltet.\n\nIm Laden: Flammenwerfer\nGut gegen: Schwärme, Waldspucker\nAb Welle: 15\nBraucht: Industrie > Kohlekraftwerk, Industrie > Raffinerie und Öl"), TEXT("New turret: flame cone with afterburn, hits everything in the cone. Fuel from Crude Oil (Oil Extractor, Refinery) by pipe. This also unlocks Level 2 in the turret window.\n\nIn the Shop: Flamethrower\nGood against: swarms, Forest Spitters\nFrom wave: 15\nRequires: Industry > Coal Power, Industry > Refinery and Oil") },
		{ TEXT("Neuer Turm: Flugabwehr gegen fliegende Gegner (60 m, 200 Schaden in 6 m). Munition: Flak-Kanister = Aluminiumgehäuse + 2 Schwarzpulver im Assembler. Greift keine Bodengegner an. Fliegende Krabben kommen ab Welle 43 aus Krabbennestern (noch nicht gebaut). Braucht Schwerindustrie und 25 MW.\n\nIm Laden: Himmelsturm\nGut gegen: fliegende Krabben\nAb Welle: 35\nBraucht: Ballistik > Nobelisk-Werfer, Industrie > Bauxit und Aluminium, Industrie > Schwerindustrie"), TEXT("New turret: anti-air against flying enemies (60 m, 200 damage in 6 m). Ammo: Flak Canister = Aluminum Casing + 2 Black Powder in the Assembler. Does not attack ground enemies. Flying Crabs come from Crab Nests from wave 43 (not built yet). Requires Heavy Industry and 25 MW.\n\nIn the Shop: Sky Tower\nGood against: Flying Crabs\nFrom wave: 35\nRequires: Ballistics > Nobelisk Launcher, Industry > Bauxite and Aluminum, Industry > Heavy Industry") },
		{ TEXT("Neuer Turm: Flugabwehr gegen fliegende Krabben (60 m, 200 Schaden in 6 m). Munition: Flak-Kanister = Aluminiumgehäuse + 2 Schwarzpulver im Assembler. Greift keine Bodengegner an.\n\nIm Laden: Himmelsturm\nGut gegen: fliegende Krabben\nAb Welle: 25\nBraucht: Ballistik > Nobelisk-Werfer, Industrie > Bauxit und Aluminium"), TEXT("New turret: anti-air against Flying Crabs (60 m, 200 damage in 6 m). Ammo: Flak Canister = Aluminum Casing + 2 Black Powder in the Assembler. Does not attack ground enemies.\n\nIn the Shop: Sky Tower\nGood against: Flying Crabs\nFrom wave: 25\nRequires: Ballistics > Nobelisk Launcher, Industry > Bauxite and Aluminum") },
		{ TEXT("Neuer Turm: Kettenblitz aus Strom, ohne Munition, springt auf 3 weitere Gegner. Braucht beim Aufladen 125 MW. Level 2 im Turmfenster ist damit freigeschaltet.\n\nIm Laden: Teslaspule\nGut gegen: Gruppen, Wasserspucker\nAb Welle: 6\nBraucht: Industrie > Kohlekraftwerk"), TEXT("New turret: chain lightning from power, no ammo, jumps to 3 more enemies. Needs 125 MW while charging. This also unlocks Level 2 in the turret window.\n\nIn the Shop: Tesla Coil\nGood against: groups, Water Spitters\nFrom wave: 6\nRequires: Industry > Coal Power") },
		{ TEXT("Neuer Turm: Kettenblitz aus Strom, ohne Munition, springt auf weitere Gegner. Braucht beim Aufladen 75 MW. Level 2 im Turmfenster ist damit freigeschaltet.\n\nIm Laden: Teslaspule\nGut gegen: Gruppen, Wasserspucker\nAb Welle: 6\nBraucht: Industrie > Kohlekraftwerk"), TEXT("New turret: chain lightning from power, no ammo, jumps to further enemies. Needs 75 MW while charging. This also unlocks Level 2 in the turret window.\n\nIn the Shop: Tesla Coil\nGood against: groups, Water Spitters\nFrom wave: 6\nRequires: Industry > Coal Power") },
		{ TEXT("Neuer Turm: wirft Nobelisken im Bogen, großer Flächenschaden (Explosion). Schwarzpulver: Kohle + Schwefel; Nobelisk: 2 Schwarzpulver + Stahlrohr (Assembler). Level 2 im Turmfenster ist damit freigeschaltet.\n\nIm Laden: Nobelisk-Werfer\nGut gegen: Gruppen auf Entfernung\nAb Welle: 10\nBraucht: Industrie > Gießerei und Stahl, Industrie > Schwefel"), TEXT("New turret: lobs Nobelisks in an arc, large area damage (explosion). Black Powder: Coal + Sulfur; Nobelisk: 2 Black Powder + Steel Pipe (Assembler). This also unlocks Level 2 in the turret window.\n\nIn the Shop: Nobelisk Launcher\nGood against: groups at range\nFrom wave: 10\nRequires: Industry > Foundry and Steel, Industry > Sulfur") },
		{ TEXT("Neues Gebäude: Bodenplatte 8 x 8 m, per Rohr mit Schwerölrückstand aus der Raffinerie versorgt. Gegner darauf laufen 35 % langsamer. Kombination Ölbrand: Flammenwerfer, Brandmunition, Feuerteppich oder ein Lockfeuer in 12 m entzünden die nasse Platte 5 s lang (20 Schaden/s), und wer hindurchläuft, brennt danach 3 s weiter. Braucht 2 MW.\n\nIm Laden: Ölschlick-Feld\nGut gegen: Massen vor Flammenwerfern\nAb Welle: 15\nBraucht: Elementar > Flammenwerfer, Industrie > Raffinerie und Öl"), TEXT("New building: 8 x 8 m floor plate, supplied with Heavy Oil Residue from the Refinery by pipe. Enemies on it move 35% slower. Oil Fire combo: Flamethrowers, Incendiary Ammo, Carpet of Fire or a Lure Fire within 12 m ignite the wet plate for 5 s (20 damage/s), and anyone walking through keeps burning for 3 s afterwards. Needs 2 MW.\n\nIn the Shop: Oil Slick Field\nGood against: masses in front of Flamethrowers\nFrom wave: 15\nRequires: Elemental > Flamethrower, Industry > Refinery and Oil") },
		{ TEXT("Neues Gebäude: Bodenplatte 8 x 8 m, per Rohr mit Schwerölrückstand aus der Raffinerie versorgt. Gegner darauf laufen 35 % langsamer; trifft ein Flammenwerfer einen Gegner darauf, brennt die Platte 5 s.\n\nIm Laden: Ölschlick-Feld\nGut gegen: Massen vor Flammenwerfern\nAb Welle: 15\nBraucht: Elementar > Flammenwerfer, Industrie > Raffinerie und Öl\nAbzweigung: schließt Elektrozaun für diesen Einsatz aus"), TEXT("New building: 8 x 8 m floor plate, supplied with Heavy Oil Residue from the Refinery by pipe. Enemies on it move 35% slower; if a Flamethrower hits an enemy on it, the plate burns for 5 s.\n\nIn the Shop: Oil Slick Field\nGood against: masses in front of Flamethrowers\nFrom wave: 15\nRequires: Elemental > Flamethrower, Industry > Refinery and Oil\nBranch: excludes Electric Fence for this operation") },
		{ TEXT("Neues Gebäude: Lager mit Mercer-Kugel, versorgt alle Türme in 30 m direkt mit der passenden Munition aus seinem Inhalt. Kostet eine Mercer-Kugel.\n\nIm Laden: Dimensionslager\nGut gegen: Türme ohne Bandanschluss\nAb Welle: 45\nBraucht: Festung > Turmfertigung IV: Meisterstufe"), TEXT("New building: storage with a Mercer Sphere, supplies all turrets within 30 m directly with the matching ammo from its contents. Costs a Mercer Sphere.\n\nIn the Shop: Dimensional Storage\nGood against: turrets without a belt connection\nFrom wave: 45\nRequires: Fortress > Turret Fabrication IV: Master Tier") },
		{ TEXT("Neues Gebäude: Mauerstück 8 x 4 m mit Kupferstäben. Für Gegner eine Mauer; wer ihn angreift, bekommt einen Stromschlag (15 Schaden, 1 s Betäubung). Kombination Leiter: eine Teslaspule in Reichweite leitet ihre Entladung über den Zaun an bis zu 3 Gegner, die ihn berühren (30 % Schaden). Braucht 2 MW.\n\nIm Laden: Elektrozaun\nGut gegen: Gegner an Mauern (Strom)\nAb Welle: 12\nBraucht: Elementar > Teslaspule"), TEXT("New building: 8 x 4 m wall piece with copper rods. A wall to enemies; whoever attacks it gets an electric shock (15 damage, 1 s stun). Conductor combo: a Tesla Coil in range conducts its discharge through the fence to up to 3 enemies touching it (30% damage). Needs 2 MW.\n\nIn the Shop: Electric Fence\nGood against: enemies at walls (electric)\nFrom wave: 12\nRequires: Elemental > Tesla Coil") },
		{ TEXT("Neues Gebäude: Radarmast mit Leitsender. Türme in 30 m bekommen +10 % Reichweite. Braucht dauernd 15 MW.\n\nIm Laden: Funkmast\nGut gegen: Türme mit knapper Reichweite\nAb Welle: 12\nBraucht: Festung > Verstärkte Mauern, Industrie > Quarzverarbeitung"), TEXT("New building: radar mast with a guidance transmitter. Turrets within 30 m get +10% range. Constantly needs 15 MW.\n\nIn the Shop: Radio Mast\nGood against: turrets with short range\nFrom wave: 12\nRequires: Fortress > Reinforced Walls, Industry > Quartz Processing") },
		{ TEXT("Neues Gebäude: Tor für die Mauerlinie (8 m breit, Öffnung 4 x 4 m). Öffnet sich für dich und Fahrzeuge, Gegner kommen nie durch und greifen es wie eine Mauer an. Ein Förderband passt unten durch.\n\nIm Laden: Tor\nGut gegen: eingemauerte Basis\nAb Welle: 6\nBraucht: Festung > Verstärkte Mauern"), TEXT("New building: gate for the wall line (8 m wide, 4 x 4 m opening). Opens for you and vehicles; enemies never get through and attack it like a wall. A conveyor belt fits underneath.\n\nIn the Shop: Gate\nGood against: walled-in bases\nFrom wave: 6\nRequires: Fortress > Reinforced Walls") },
		{ TEXT("Neues Gebäude: Tor für die Mauerlinie (8 m breit, Öffnung 4 x 4 m). Öffnet sich für dich und Fahrzeuge, Gegner kommen nie durch und greifen es wie eine Mauer an. Ein Förderband passt unten durch. Kombination Engstelle: am Tor laufen Gegner in einer Reihe, Bolzen durchschlagen dort einen Gegner mehr.\n\nIm Laden: Tor\nGut gegen: eingemauerte Basis\nAb Welle: 6\nBraucht: Festung > Verstärkte Mauern"), TEXT("New building: gate for the wall line (8 m wide, 4 x 4 m opening). Opens for you and vehicles; enemies never get through and attack it like a wall. A conveyor belt fits underneath. Chokepoint combo: at the Gate, enemies walk in single file, and bolts pierce one extra enemy there.\n\nIn the Shop: Gate\nGood against: walled-in bases\nFrom wave: 6\nRequires: Fortress > Reinforced Walls") },
		{ TEXT("Neues Gebäude: repariert Mauern, Türme und Kern im Umkreis von 25 m. Verbraucht Eisenplatten oder verstärkte Platten.\n\nIm Laden: Reparaturstation\nGut gegen: lange Wellen\nBraucht: Festung > Notreparatur, Industrie > Assembler und Eisenteile"), TEXT("New building: repairs walls, turrets and the Core within 25 m. Consumes Iron Plates or Reinforced Iron Plates.\n\nIn the Shop: Repair Station\nGood against: long waves\nRequires: Fortress > Emergency Repair, Industry > Assembler and Iron Parts") },
		{ TEXT("Neues Gebäude: verbrennt Kohle und lockt dabei 15 s lang alle Gegner in 40 m an, danach 30 s Pause. Lenkt Wellen auf eine Turmgruppe. Braucht Strom.\n\nIm Laden: Lockfeuer\nGut gegen: Wellen auf die Türme lenken\nAb Welle: 8\nBraucht: Festung > Tor"), TEXT("New building: burns Coal and lures all enemies within 40 m for 15 s, then pauses for 30 s. Steers waves onto a turret group. Needs power.\n\nIn the Shop: Lure Fire\nGood against: steering waves onto the turrets\nFrom wave: 8\nRequires: Fortress > Gate") },
		{ TEXT("Neues Gebäude: verbrennt Kohle und lockt dabei 15 s lang alle Gegner in 40 m an, danach 30 s Pause. Lenkt Wellen auf eine Turmgruppe. Kombination Sammelpunkt: gelockte Gegner nehmen 25 % mehr Explosionsschaden. Sein Feuer entzündet nasse Ölschlick-Felder in 12 m. Braucht 5 MW.\n\nIm Laden: Lockfeuer\nGut gegen: Wellen auf die Türme lenken\nAb Welle: 8\nBraucht: Festung > Tor"), TEXT("New building: burns Coal and lures all enemies within 40 m for 15 s, then pauses for 30 s. Steers waves onto a turret group. Rally Point combo: lured enemies take 25% more explosion damage. Its fire ignites wet Oil Slick Fields within 12 m. Needs 5 MW.\n\nIn the Shop: Lure Fire\nGood against: steering waves onto the turrets\nFrom wave: 8\nRequires: Fortress > Gate") },
