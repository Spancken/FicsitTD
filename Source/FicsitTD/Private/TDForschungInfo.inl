	{ TEXT("Festung"), TEXT("Festung"), TEXT("Lockfeuer"), TEXT("Lockfeuer"), TEXT("Neues Gebäude: verbrennt Kohle und lockt dabei 15 s lang alle Gegner in 40 m an, danach 30 s Pause. Lenkt Wellen auf eine Turmgruppe. Kombination Sammelpunkt: gelockte Gegner nehmen 25 % mehr Explosionsschaden. Sein Feuer entzündet nasse Ölschlick-Felder in 12 m. Braucht 5 MW."), TEXT("Lockfeuer"), TEXT("Wellen auf die Türme lenken"), 4, 8, TEXT("Tor"), TEXT(""), TEXT("/FicsitTD/Research/Befestigung/Research_TD_Lockfeuer.Research_TD_Lockfeuer_C") },
